---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations } from "../i18n/utils";

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="sticky top-0 z-50 border-b border-emerald-100 bg-white/80 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href={`/${lang}`} class="text-xl font-black text-emerald-700">
      ZOOBLOG
    </a>

    <div class="flex items-center gap-6 text-sm font-bold text-slate-700">
      <a href={`/${lang}`} class="hover:text-emerald-700">
        {t("home")}
      </a>

      <a href={`/${lang}/blog`} class="hover:text-emerald-700">
        {t("blog")}
      </a>

      <a href={`/${lang}/about`} class="hover:text-emerald-700">
        {t("about")}
      </a>

      <a href={`/${lang}/services`} class="hover:text-emerald-700">
        {t("services")}
      </a>

      <LanguageSwitcher lang={lang} />
    </div>
  </nav>
</header>